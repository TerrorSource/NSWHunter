# Copy to .env and adjust.
#
# Almost everything is set in the panel and is then kept in settings.json in /config. An
# environment variable only gives the first value; a saved value always takes precedence.
# What is only here: the timing, which indexers of Prowlarr, and the addresses at the end.
TZ=Etc/UTC
# Only when the container starts as root, without a 'user:' line: the user and group that
# NSWHunter runs as and that owns the config folder.
PUID=1000
PGID=1000
# The port of the panel in the container.
PORT=3033

# --- The library (panel: Settings > Connect) --------------------------------------------
# NSWHunter fetches /export/library.json. Make the key in Switch-library-manager-web
# under My account > API keys > Make a key; "Read only" is enough. You can only leave
# it empty if login is switched off there.
SLM_URL=http://192.168.1.10:3000
SLM_API_KEY=
# Also look for the games of the wishlist of switch-library-manager-web (2.0.22 or later).
SLM_WISHLIST=true

# --- Read once: the first indexer, download client and connection ------------------------
# Indexers, download clients and connections are lists in the panel. At the very first start
# these variables become their first entries; after that they are not read again.
PROWLARR_URL=http://192.168.1.10:9696
PROWLARR_API_KEY=
# Newznab categories, comma-separated. 1000 = Console with all its subcategories.
PROWLARR_CATEGORIES=1000
# nzbget | sabnzbd | prowlarr (= the download client that is set up in Prowlarr itself).
DOWNLOAD_CLIENT=nzbget
DOWNLOAD_CATEGORY=games
NZBGET_URL=http://192.168.1.10:6789
NZBGET_USER=nzbget
NZBGET_PASSWORD=
SABNZBD_URL=
SABNZBD_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Ask per release in Telegram, with buttons to download or reject it there. Only for a bot that
# NSWHunter has to itself: it then reads what the bot receives.
TELEGRAM_ASK=false
# Apprise URLs, comma-separated. For example ntfy://ntfy.sh/my-secret-topic
NOTIFY_URLS=

# --- What happens by itself (panel: Settings > Media Management) ------------------------
# off = nothing is sent by itself; you choose in the panel.
# 5 to 10 = per game the best release is sent by itself if its score (1-10, the chance that
#   the download is the right one) is at least this high. 9 is careful, 7 also takes releases
#   whose version is derived from dates or numbering.
AUTO_DOWNLOAD=off
# Also send a game of the wishlist by itself. Off: a whole game always waits for your click.
AUTO_WISHLIST=false
# A release of a whole game for the wishlist under this many MB is ruled out (broken or a fake); 0 = no minimum.
MIN_GAME_MB=20
# Also search for missing DLC.
INCLUDE_DLC=true
# Every game that misses something is searched by name once per this many hours: 6, 12, 24 or 48.
SEARCH_INTERVAL_HOURS=24
# How long a sent release may take to show up in the library: 30, 60, 120, 360 or 1440 minutes.
GRAB_WAIT_MINUTES=30
# Keep failed downloads out of the lists, and do not offer the same usenet release again when
# another indexer has it too.
HIDE_FAILED_DOWNLOADS=true
# Put a finished download in the folder of its game in the library. Needs a root folder (set in
# the panel) and the download folder and the library as volumes of the container.
IMPORT_COMPLETED=true
# The folder of a game in the root folder, as Organize of Switch-library-manager-web names it.
# Empty: a download goes next to the files its game already has.
FOLDER_TEMPLATE={TITLE_NAME} [{TITLE_ID}]
# After the files of a download were moved to the library, remove its folder if it is empty.
DELETE_EMPTY_FOLDERS=true
# What is removed from the folder of a download once its Switch files are in the library:
# endings and words, separated by commas. Remove Completed and Remove Failed are set per
# download client in the panel.
CLEANUP_EXTENSIONS=.nfo, .jpg, .jpeg, .png, .sfv, .txt, .url, .par2, sample

# --- Only here: timing and details -------------------------------------------------------
# Also send bundles (base game + update) by themselves.
AUTO_BUNDLES=false
# At most this many releases are sent by themselves per round.
MAX_GRABS_PER_RUN=10
# Every round: fetch the library and look at the newest posts of your indexers (one search).
SYNC_INTERVAL_MINUTES=60
# At most this many games are searched by name per round; 0 = no limit.
BACKLOG_PER_RUN=0
SEARCH_DELAY_SECONDS=3
# Also search by title ID per game (doubles the number of API calls).
SEARCH_BY_TITLE_ID=false
# Every this many seconds the download clients are asked how the sent releases are doing.
WATCH_SECONDS=120
# Use only these indexers of Prowlarr (IDs from Prowlarr, comma-separated). Empty = all of them.
PROWLARR_INDEXER_IDS=
# The list of all updates per game with their date. Several addresses, comma-separated: the
# first one that answers. Empty = do not use.
TITLEDB_VERSIONS_URL=https://github.com/DeLFuS77/switch-library-manager-web/releases/download/data/versions.json,https://raw.githubusercontent.com/blawar/titledb/master/versions.json
# The names, pictures and release dates of all games, for Add Game; fetched once a week.
TITLEDB_TITLES_URL=https://github.com/DeLFuS77/switch-library-manager-web/releases/download/data/titles.json.zst

# --- The login (panel: Settings > General) -----------------------------------------------
# Without a password the first start makes one up for this user and writes it to the log of
# the container; it has to be changed at the first login. A password given here (at least
# 8 characters) is used as it is.
PANEL_USER=admin
PANEL_PASSWORD=
# Extra host names the panel answers to, comma-separated: the name of a reverse proxy, for example.
# An IP address and a name inside the home network (nas, nas.local) always work.
PANEL_HOSTS=
# The panel over HTTPS as well, on a port of its own that the container has to publish. Without
# a certificate (a PEM file, and its key if that is in another file) NSWHunter makes one itself.
SSL_ENABLED=false
SSL_PORT=3443
SSL_CERT_PATH=
SSL_KEY_PATH=

# --- Logging and backups (panel: Settings > General) -------------------------------------
# info | debug | trace
LOG_LEVEL=info
# There is one log file per day (nswhunter_2026-03-25.txt). Days of them that are kept: 7, 14, 30 or 90.
LOG_KEEP_DAYS=14
# Another folder has to be a volume of the container.
BACKUP_FOLDER=/config/backups
# With a password the backups are encrypted: a backup holds every key and password of the settings.
BACKUP_PASSWORD=
BACKUP_INTERVAL_DAYS=7
BACKUP_RETENTION_DAYS=28

# --- The look (panel: Settings > UI) -----------------------------------------------------
# auto | dark | light
UI_THEME=auto
# browser | iso | dmy | mdy | long
UI_DATE_FORMAT=browser
# browser | 24 | 12
UI_TIME_FORMAT=browser
UI_RELATIVE_DATES=true
# browser | dmy (Tuesday, 25 March, 2026) | mdy (Tuesday, March 25, 2026)
UI_LONG_DATE_FORMAT=browser
# Blue and orange instead of green and red
UI_COLOR_IMPAIRED=false
