# Kopieer naar .env en pas aan.
#
# De adressen, keys, downloadclient, AUTO_DOWNLOAD, INCLUDE_DLC en de inlog van het paneel
# en het zoekinterval stel je in op de tab Configuratie van het paneel; ze staan dan in /data/settings.json.
# Hier invullen kan ook: dat is de beginwaarde. Een opgeslagen waarde gaat altijd voor.
# De overige instellingen (tempo, indexers, meldingen) staan alleen hier.
TZ=Etc/UTC
# De gebruiker en groep waaronder NSWHunter draait en waarvan /data is.
PUID=1000
PGID=1000
# De poort van het paneel in de container.
PORT=3033

# --- Switch-library-manager-web: je bibliotheek en wat er ontbreekt -------------------
# NSWHunter haalt /export/library.json op. Maak de key in Switch-library-manager-web
# onder Mijn account > API keys; "Alleen lezen" is genoeg. Leeg laten kan alleen als
# inloggen daar uit staat.
SLM_URL=http://192.168.1.10:3000
SLM_API_KEY=

# --- Prowlarr: zoeken op je indexers ---------------------------------------------------
PROWLARR_URL=http://192.168.1.10:9696
PROWLARR_API_KEY=
# Newznab-categorieën, komma-gescheiden. 1000 = Console met alle subcategorieën.
PROWLARR_CATEGORIES=1000
# Alleen deze indexers gebruiken (ID's uit Prowlarr, komma-gescheiden). Leeg = alle usenet-indexers.
PROWLARR_INDEXER_IDS=

# --- Downloadclient --------------------------------------------------------------------
# nzbget | sabnzbd | prowlarr (= de downloadclient die in Prowlarr zelf is ingesteld;
# de categorie bepaalt Prowlarr dan).
DOWNLOAD_CLIENT=nzbget
DOWNLOAD_CATEGORY=games
NZBGET_URL=http://192.168.1.10:6789
NZBGET_USER=nzbget
NZBGET_PASSWORD=
SABNZBD_URL=
SABNZBD_API_KEY=

# --- Wat er vanzelf gaat ---------------------------------------------------------------
# off = niets gaat vanzelf; je kiest in het paneel.
# 5 t/m 10 = per game gaat de beste release vanzelf als zijn score (1-10, de kans dat de
#   download de juiste is) minstens zo hoog is. 9 is voorzichtig, 7 neemt ook releases mee
#   waarvan de versie is afgeleid van datums of nummering.
AUTO_DOWNLOAD=off
# Ook bundels (basisspel + update) vanzelf versturen.
AUTO_BUNDLES=false
# Hooguit zoveel releases per ronde vanzelf versturen.
MAX_GRABS_PER_RUN=10
# Ook ontbrekende DLC zoeken. Zonder title ID in de releasenaam is DLC altijd een twijfelgeval.
INCLUDE_DLC=false

# --- Tempo -----------------------------------------------------------------------------
# Elke ronde: bibliotheek ophalen en de nieuwste posts van je indexers bekijken (één zoekactie).
SYNC_INTERVAL_MINUTES=60
# Elke game die iets mist wordt eens per zoveel uur op naam gezocht: 6, 12, 24 of 48.
# Ook in te stellen op de tab Configuratie. Op naam zoeken kost per game één API-call per indexer.
SEARCH_INTERVAL_HOURS=24
# Hooguit zoveel games per ronde op naam zoeken; 0 = geen limiet.
BACKLOG_PER_RUN=0
SEARCH_DELAY_SECONDS=3
# Per game ook op title ID zoeken (verdubbelt het aantal API-calls).
SEARCH_BY_TITLE_ID=false
# Zo lang mag een verstuurde release erover doen om in de bibliotheek te staan: 30, 60, 120,
# 360 of 1440 minuten. Ook in te stellen op de tab Configuratie.
GRAB_WAIT_MINUTES=60
# Om de zoveel seconden vraagt NSWHunter de downloadclient hoe het met verstuurde releases gaat.
WATCH_SECONDS=120
# Lijst van alle updates per game met hun datum. Meerdere adressen, komma-gescheiden: het
# eerste dat antwoordt. Leeg = niet gebruiken.
TITLEDB_VERSIONS_URL=https://github.com/DeLFuS77/switch-library-manager-web/releases/download/data/versions.json,https://raw.githubusercontent.com/blawar/titledb/master/versions.json

# --- Paneel en meldingen ---------------------------------------------------------------
PANEL_USER=admin
# Leeg = paneel zonder inlog.
PANEL_PASSWORD=
# Meldingen via Telegram: ook in te stellen op de tab Configuratie.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Meldingen via Apprise voor andere diensten, komma-gescheiden. Bijvoorbeeld ntfy://ntfy.sh/mijn-geheime-topic
NOTIFY_URLS=
