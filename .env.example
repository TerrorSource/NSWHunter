# Copy to .env and adjust.
#
# The addresses, keys, download client, AUTO_DOWNLOAD, INCLUDE_DLC, the login of the panel
# and the search interval are set on the Configuration tab of the panel; they are then in /data/settings.json.
# You can also fill them in here: that is the initial value. A saved value always takes precedence.
# The other settings (timing, indexers, notifications through Apprise) are only here.
TZ=Etc/UTC
# The user and group that NSWHunter runs as and that owns /data.
PUID=1000
PGID=1000
# The port of the panel in the container.
PORT=3033

# --- Switch-library-manager-web: your library and what is missing ---------------------
# NSWHunter fetches /export/library.json. Make the key in Switch-library-manager-web
# under My account > API keys > Make a key; "Read only" is enough. You can only leave
# it empty if login is switched off there.
SLM_URL=http://192.168.1.10:3000
SLM_API_KEY=

# --- Prowlarr: searching on your indexers ----------------------------------------------
PROWLARR_URL=http://192.168.1.10:9696
PROWLARR_API_KEY=
# Newznab categories, comma-separated. 1000 = Console with all its subcategories.
PROWLARR_CATEGORIES=1000
# Use only these indexers (IDs from Prowlarr, comma-separated). Empty = all usenet indexers.
PROWLARR_INDEXER_IDS=

# --- Download client -------------------------------------------------------------------
# nzbget | sabnzbd | prowlarr (= the download client that is set up in Prowlarr itself;
# Prowlarr then decides the category).
DOWNLOAD_CLIENT=nzbget
DOWNLOAD_CATEGORY=games
NZBGET_URL=http://192.168.1.10:6789
NZBGET_USER=nzbget
NZBGET_PASSWORD=
SABNZBD_URL=
SABNZBD_API_KEY=

# --- What is sent automatically --------------------------------------------------------
# off = nothing is sent automatically; you choose in the panel.
# 5 to 10 = per game the best release is sent automatically if its score (1-10, the chance
#   that the download is the right one) is at least that high. 9 is careful, 7 also takes
#   releases whose version is derived from dates or numbering.
AUTO_DOWNLOAD=off
# Also send bundles (base game + update) automatically.
AUTO_BUNDLES=false
# Send at most this many releases automatically per round.
MAX_GRABS_PER_RUN=10
# Also search for missing DLC. Without a title ID in the release name DLC is always a doubtful case.
INCLUDE_DLC=false

# --- Timing ----------------------------------------------------------------------------
# Every round: fetch the library and look at the newest posts of your indexers (one search).
SYNC_INTERVAL_MINUTES=60
# Every game that misses something is searched by name once per this many hours: 6, 12, 24 or 48.
# Can also be set on the Configuration tab. Searching by name costs one API call per indexer per game.
SEARCH_INTERVAL_HOURS=24
# Search at most this many games by name per round; 0 = no limit.
BACKLOG_PER_RUN=0
SEARCH_DELAY_SECONDS=3
# Also search by title ID per game (doubles the number of API calls).
SEARCH_BY_TITLE_ID=false
# This is how long a sent release may take to be in the library: 30, 60, 120,
# 360 or 1440 minutes. Can also be set on the Configuration tab.
GRAB_WAIT_MINUTES=60
# Every this many seconds NSWHunter asks the download client how sent releases are doing.
WATCH_SECONDS=120
# List of all updates per game with their date. Several addresses, comma-separated: the
# first one that answers. Empty = do not use.
TITLEDB_VERSIONS_URL=https://github.com/DeLFuS77/switch-library-manager-web/releases/download/data/versions.json,https://raw.githubusercontent.com/blawar/titledb/master/versions.json

# --- Panel and notifications -----------------------------------------------------------
PANEL_USER=admin
# Empty = panel without login.
PANEL_PASSWORD=
# Notifications through Telegram: can also be set on the Configuration tab.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Notifications through Apprise for other services, comma-separated. For example ntfy://ntfy.sh/my-secret-topic
NOTIFY_URLS=
